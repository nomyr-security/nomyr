{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nomyr.dev/usage-metrics/v1/event.schema.json",
  "title": "Nomyr anonymous usage metrics event",
  "type": "object",
  "required": [
    "schema_version",
    "event",
    "installation_id",
    "occurred_at",
    "version",
    "os",
    "arch"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "event": {"enum": ["installation_created", "command_completed"]},
    "installation_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "os": {"type": "string", "minLength": 1, "maxLength": 32},
    "arch": {"type": "string", "minLength": 1, "maxLength": 32},
    "command": {"type": "string", "minLength": 1, "maxLength": 64},
    "success": {"type": "boolean"},
    "duration_ms": {"type": "integer", "minimum": 0, "maximum": 3600000}
  },
  "allOf": [
    {
      "if": {"properties": {"event": {"const": "command_completed"}}},
      "then": {"required": ["command", "success", "duration_ms"]}
    }
  ],
  "additionalProperties": false
}
